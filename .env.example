# Copy to apps/api/.env and apps/web/.env.local

DATABASE_URL="postgresql://pawmarket:pawmarket@localhost:5432/pawmarket?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
PAYMENT_SECRET=""
PAYMENT_WEBHOOK_SECRET=""
EMAIL_HOST="localhost"
EMAIL_USER=""
EMAIL_PASSWORD=""
API_PORT=3001
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
DEFAULT_CURRENCY="PKR"
PAYMENT_LIVE="false"
# JazzCash (sandbox or live merchant portal)
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_RETURN_URL="http://localhost:3000/checkout/return?provider=jazzcash"
JAZZCASH_POST_URL=""
JAZZCASH_CARD_TXN_TYPE="MPAY"
# EasyPaisa
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_POSTBACK_URL="http://localhost:3000/checkout/return?provider=easypaisa"
EASYPAISA_POST_URL=""
# Optional card via Stripe
STRIPE_SECRET_KEY=""
LOG_LEVEL="info"
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
RATE_LIMIT_MAX=180
ENABLE_SWAGGER="true"
IMAGE_CDN_BASE=""
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
